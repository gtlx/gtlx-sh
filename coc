#
# 用法:
#   coc              扫描模式
#   coc --clean      扫描后交互式清理
#   coc --verbose    显示全部
#   coc --json       输出 JSON
#
# 检测方式（多重交叉验证）:
#   1. 映射表:  config目录名 ↔ 包名/命令名
#   2. 包管理器: pacman / dpkg 查包是否安装
#   3. AppImage: 扫描 ~/软件/, ~/Applications/ 等常用目录
#   4. .desktop: 检查 /usr/share/applications
#   5. 特征识别: KDE .rc 文件、系统自动生成文件等

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
VERBOSE=false
CLEAN=false
JSON=false

# AppImage 扫描路径
APPIMAGE_DIRS=(
  "$HOME/软件"
  "$HOME/Applications"
  "$HOME/AppImages"
  "$HOME/.local/bin"
)

while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean|-c)    CLEAN=true; shift ;;
    --verbose|-v)  VERBOSE=true; shift ;;
    --json|-j)     JSON=true; shift ;;
    --help|-h)
      echo "用法: coc [--clean] [--verbose] [--json]"
      echo "  扫描 ~/.config 中已卸载软件的配置残留"
      echo "  --clean     扫描后交互式清理"
      echo "  --json      输出 JSON"
      echo "  --verbose   显示正常条目"
      exit 0 ;;
    *) echo "未知参数: $1"; exit 1 ;;
  esac
done

# ── 工具函数 ──

has_cmd()    { command -v "$1" &>/dev/null; }
has_pac()    { has_cmd pacman && pacman -Qi "$1" &>/dev/null; }
has_dpkg()   { has_cmd dpkg-query && dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
has_flatpak(){ has_cmd flatpak && flatpak info "$1" &>/dev/null; }

pkg_ok() {
  local pkg="$1"
  has_pac "$pkg" && return 0
  has_dpkg "$pkg" && return 0
  return 1
}

cmd_ok() {
  local name="$1"
  has_cmd "$name" && return 0
  has_cmd "${name,,}" && return 0
  local flat="${name//[-_]/}"
  has_cmd "$flat" && return 0
  return 1
}

desktop_ok() {
  local name="$1" lower="${1,,}"
  find /usr/share/applications "$HOME/.local/share/applications" \
    -maxdepth 1 \( -name "*${name}*" -o -name "*${lower}*" \) 2>/dev/null | grep -q .
}

# AppImage 检测：在常见路径下查找包含 config 名的 .AppImage 文件
appimage_ok() {
  local name="$1" lower="${1,,}"
  for dir in "${APPIMAGE_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    # 尝试精确匹配目录名
    find "$dir" -maxdepth 1 -name "*${name}*.AppImage" 2>/dev/null | grep -q . && return 0
    find "$dir" -maxdepth 1 -name "*${lower}*.AppImage" 2>/dev/null | grep -q . && return 0
    # 尝试去连字符匹配
    local flat="${name//[-_]/}"
    find "$dir" -maxdepth 1 -name "*${flat}*.AppImage" 2>/dev/null | grep -q . && return 0
  done
  return 1
}

# ── 映射表：config名 | 包名(逗号分隔) | 命令名(逗号分隔) | AppImage名(逗号分隔) ──
declare -a MAP
def_map() { MAP+=("$1|$2|$3|$4"); }

def_map "aseprite"        "aseprite,aseprite-bin"            "aseprite"                  "-"

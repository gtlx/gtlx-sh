# ── 分类核心 ──
# 输出格式: status|reason|size|age_days
classify() {
  local entry="$1" basename="$2" entry_type="$3"

  local size="?"
  local mtime_age
  size="$(du -sh "$entry" 2>/dev/null | cut -f1 || true)"
  [[ -z "$size" ]] && size="?"
  local mtime_epoch
  mtime_epoch="$(stat -c '%Y' "$entry" 2>/dev/null || echo 0)"
  local now_epoch
  now_epoch="$(date +%s)"
  mtime_age=$(( (now_epoch - mtime_epoch) / 86400 ))

  local de_lower
  de_lower="$(echo "${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-unknown}}" | tr '[:upper:]' '[:lower:]')"

  # ── 查映射表 ──
  for mapping in "${MAP[@]}"; do
    local map_name="${mapping%%|*}"
    local rest="${mapping#*|}"
    local pkg_list="${rest%%|*}"
    rest="${rest#*|}"
    local cmd_list="${rest%%|*}"
    local appimage_list="${rest#*|}"

    [[ "$map_name" != "$basename" ]] && continue

    # 1) 包管理器检查
    if [[ "$pkg_list" != "-" ]]; then
      IFS=',' read -ra pkgs <<< "$pkg_list"
      for p in "${pkgs[@]}"; do
        pkg_ok "$p" && echo "ok|package: $p|$size|$mtime_age" && return
      done
    fi

    # 2) 命令检查
    if [[ "$cmd_list" != "-" ]]; then
      IFS=',' read -ra cmds <<< "$cmd_list"
      for c in "${cmds[@]}"; do
        cmd_ok "$c" && echo "ok|command: $c|$size|$mtime_age" && return
      done
    fi

    # 3) AppImage 检查
    if [[ "$appimage_list" != "-" ]]; then
      IFS=',' read -ra apps <<< "$appimage_list"
      for a in "${apps[@]}"; do
        appimage_ok "$a" && echo "ok|AppImage: $a|$size|$mtime_age" && return
      done
    fi

    # 4) .desktop 检查
    desktop_ok "$basename" && echo "ok|.desktop found|$size|$mtime_age" && return

    # 5) Flatpak 检查
    has_flatpak "$basename" && echo "ok|flatpak: $basename|$size|$mtime_age" && return

    # 都没匹配到 → 孤儿
    echo "orphan|映射表命中但找不到安装包/命令/AppImage|$size|$mtime_age"
    return
  done

  # ── 不在映射表中 → 动态推断 ──

  # 1) KDE .rc 特征文件
  if [[ "$basename" == *.rc ]]; then
    if [[ "$de_lower" != *kde* && "$de_lower" != *plasma* ]]; then
      local owner=""
      has_cmd pacman && owner="$(pacman -Qo "$entry" 2>/dev/null | grep -oP 'is owned by \K\S+' || true)"
      if [[ -n "$owner" ]]; then
        pkg_ok "$owner" && echo "ok|package: $owner (owner)|$size|$mtime_age" && return
        echo "orphan|KDE .rc 归属包 $owner 未安装|$size|$mtime_age" && return
      fi
      echo "orphan|KDE .rc 残留|$size|$mtime_age" && return
    fi
  fi

  # 2) 命令名检测
  cmd_ok "$basename" && echo "ok|命令: $basename|$size|$mtime_age" && return

  # 3) AppImage 检测
  appimage_ok "$basename" && echo "ok|AppImage: $basename|$size|$mtime_age" && return

  # 4) 包名检测（仅目录）
  if [[ "$entry_type" == "dir" ]]; then
    local lower="${basename,,}"
    pkg_ok "$basename" && echo "ok|package: $basename|$size|$mtime_age" && return
    pkg_ok "$lower"    && echo "ok|package: $lower|$size|$mtime_age"    && return
  fi

  # 5) .desktop 文件
  desktop_ok "$basename" && echo "ok|.desktop found|$size|$mtime_age" && return

  # 6) 系统自动生成 → skip
  if [[ "$basename" =~ ^(dconf|pulse|autostart|configstore) ]] \
    || [[ "$basename" =~ ^(gtk-3\.0|fontconfig|xsettingsd|mimeapps|user-dirs) ]]; then
    echo "skip|系统自动生成|$size|$mtime_age" && return
  fi

  # 真·未知
  echo "unknown|无法判定归属|$size|$mtime_age"
}

# ── 工具: JSON 字符转义（纯 bash，不依赖 python3）──
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  printf '"%s"' "$s"
}

# ── 输出 ──
print_row() {
  local basename="$1" entry_type="$2" status="$3" reason="$4" size="$5"
  local color="" label=""
  case "$status" in
    ok)      color="\033[32m"; label="正常" ;;
    orphan)  color="\033[31m"; label="孤儿" ;;
    unknown) color="\033[33m"; label="未知" ;;
    skip)    color="\033[90m"; label="跳过" ;;
  esac
  local icon="📁"
  [[ "$entry_type" == "file" ]] && icon="📄"
  printf "${color}%-30s %s %6s  %-6s %s\033[0m\n" "$basename" "$icon" "$size" "$label" "$reason"
}

print_json_entry() {
  local basename="$1" entry_type="$2" status="$3" reason="$4" size="$5" mtime_age="$6"
  local is_first="$7"
  local name_esc size_esc reason_esc
  name_esc="$(json_escape "$basename")"
  size_esc="$(json_escape "$size")"
  reason_esc="$(json_escape "$reason")"
  # 在条目之间打印逗号（第一条前不打印）
  if [[ "$is_first" != "true" ]]; then
    echo ","
  fi
  echo "    {\"name\":$name_esc,\"type\":\"$entry_type\",\"status\":\"$status\",\"size\":$size_esc,\"age_days\":$mtime_age,\"reason\":$reason_esc}"
}

# ── 主流程 ──
main() {
  local de="${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-unknown}}"

  if [[ "$JSON" == false ]]; then
    echo "═══════════════════════════════════════════════════════════════"
    echo "  ~/.config 孤儿配置检查"
    echo "  桌面环境 : ${de^^}"
    echo "  包管理器 : $(has_cmd pacman && echo 'pacman' || (has_cmd dpkg && echo 'dpkg' || echo '未检测到'))"
    echo "  扫描路径 : $CONFIG_DIR"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
  fi

  local orphans=0 unknowns=0 installed=0 skipped=0 total=0
  local first_json=true

  if [[ "$JSON" == true ]]; then
    echo "{"
    echo "  \"desktop\": \"$de\","
    echo "  \"scanned_at\": \"$(date --iso-8601=seconds 2>/dev/null || date)\","
    echo "  \"entries\": ["
  fi

  for entry in "$CONFIG_DIR"/*; do
    [[ -e "$entry" ]] || continue
    local basename
    basename="$(basename "$entry")"
    [[ "$basename" == .* ]] && continue

    local entry_type="dir"
    [[ -f "$entry" ]] && entry_type="file"

    local result
    result="$(classify "$entry" "$basename" "$entry_type")"
    local status="${result%%|*}"
    local rest="${result#*|}"
    local reason="${rest%%|*}"
    rest="${rest#*|}"
    local size="${rest%%|*}"
    local mtime_age="${rest##*|}"

    total=$((total + 1))
    case "$status" in
      ok)      installed=$((installed + 1)) ;;
      orphan)  orphans=$((orphans + 1)) ;;
      unknown) unknowns=$((unknowns + 1)) ;;
      skip)    skipped=$((skipped + 1)) ;;
    esac

    if [[ "$JSON" == true ]]; then
      print_json_entry "$basename" "$entry_type" "$status" "$reason" "$size" "$mtime_age" "$first_json"
      first_json=false
    elif [[ "$status" == "orphan" || "$status" == "unknown" || "$VERBOSE" == true ]]; then
      print_row "$basename" "$entry_type" "$status" "$reason" "$size"
    fi
  done

  if [[ "$JSON" == true ]]; then
    echo ""
    echo "  ],"
    echo "  \"summary\": {"
    echo "    \"orphans\": $orphans,"
    echo "    \"unknowns\": $unknowns,"
    echo "    \"installed\": $installed,"
    echo "    \"skipped\": $skipped"
    echo "  }"
    echo "}"
    return
  fi

  # ── 统计面板 ──
  echo ""
  echo "───────────────────────────────────────────────────────────"
  echo "  统计"
  echo "───────────────────────────────────────────────────────────"
  printf "  \033[31m孤儿 (orphan):    %d\033[0m  已卸载软件的配置残留\n" "$orphans"
  printf "  \033[33m未知 (unknown):   %d\033[0m  无法判定，需要人工确认\n" "$unknowns"
  printf "  \033[32m正常 (ok):        %d\033[0m  软件仍在安装中\n" "$installed"
  printf "  \033[90m跳过 (skip):      %d\033[0m  系统自动生成\n" "$skipped"
  echo ""

  if [[ "$total" -gt 0 ]]; then
    local clean_pct=$(( (orphans + unknowns) * 100 / total ))
    echo "  提示: 可清理比例 ${clean_pct}% (孤儿+未知)，使用 --clean 交互式删除"
  fi
  echo ""

  # ── 交互清理 ──
  if [[ "$CLEAN" == true ]]; then
    local suspect_entries=()
    for entry in "$CONFIG_DIR"/*; do
      [[ -e "$entry" ]] || continue
      local basename
      basename="$(basename "$entry")"
      [[ "$basename" == .* ]] && continue
      local result
      result="$(classify "$entry" "$basename" "dir")"
      local status="${result%%|*}"
      [[ "$status" == "orphan" || "$status" == "unknown" ]] && suspect_entries+=("$entry|$basename")
    done

    if [[ ${#suspect_entries[@]} -eq 0 ]]; then
      echo "🎉 没有需要清理的条目！"
      return
    fi

    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║          交互式清理 — 选择要删除的项目                ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    local idx=0
    for item in "${suspect_entries[@]}"; do
      local name="${item#*|}"
      local path="${item%%|*}"
      local size
      size="$(du -sh "$path" 2>/dev/null | cut -f1)"
      idx=$((idx + 1))
      printf "  [%2d] %-28s %s\n" "$idx" "$name" "$size"
    done
    echo ""
    echo "  [a] 全部删除    [q] 取消"
    echo ""
    printf "  输入编号（空格分隔）: "
    read -r choice

    case "$choice" in
      q|Q) echo "已取消。"; return ;;
      a|A)
        echo "正在删除全部 ${#suspect_entries[@]} 项..."
        for item in "${suspect_entries[@]}"; do
          local path="${item%%|*}"
          rm -rf "$path"
          echo "  ❌ 已删除: $(basename "$path")"
        done
        echo "✅ 完成！"
        ;;
      *)
        for num in $choice; do
          local i=$((num - 1))
          if [[ $i -ge 0 && $i -lt ${#suspect_entries[@]} ]]; then
            local path="${suspect_entries[$i]%%|*}"
            rm -rf "$path"
            echo "  ❌ 已删除: $(basename "$path")"
          fi
        done
        echo "✅ 完成！"
        ;;
    esac
  fi
}

main "$@"

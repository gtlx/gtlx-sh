def_map "ly"              "ly"                               "ly"                        "-"
def_map "nextjs-nodejs"   "-"                                "-"                         "-"
def_map "niri"            "niri"                             "niri"                      "-"
def_map "noctalia"        "noctalia"                         "noctalia"                  "-"
def_map "nomacs"          "nomacs"                           "nomacs"                    "-"
def_map "nvim"            "neovim"                           "nvim"                      "-"
def_map "obsidian"        "obsidian"                         "obsidian"                  "Obsidian"

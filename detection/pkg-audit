#!/usr/bin/env bash
# ============================================================================
# Arch Linux 包审计脚本 — arch-pkg-audit.sh
# 功能：分析已安装包，区分系统自带/手动安装，找出可清理项
# 使用：bash arch-pkg-audit.sh
# 使用并输出 JSON：bash arch-pkg-audit.sh --json
# ============================================================================

set -uo pipefail

# ── 颜色 ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'
BOLD='\033[1m'; NC='\033[0m'

# ── 辅助函数 ──────────────────────────────────────────────────────────────
section()  { echo -e "\n${BOLD}${BLUE}══ $1 ${NC}"; }
ok()    { echo -e "  ${GREEN}✔${NC} $1"; }
warn()  { echo -e "  ${YELLOW}⚠${NC} $1"; }
info()  { echo -e "  ${CYAN}ℹ${NC} $1"; }
big()   { echo -e "  ${RED}★${NC} $1"; }

# 安全执行命令，忽略非零退出
safe_run() { "$@" 2>/dev/null || true; }

# ── 前置检查 ──────────────────────────────────────────────────────────────
for cmd in pacman pactree; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "错误：需要 $cmd，请先安装。"
    exit 1
  fi
done

# ── Banner ─────────────────────────────────────────────────────────────────
echo -e "${BOLD}${MAGENTA}"
echo "  ╔══════════════════════════════════════════════════╗"
echo "  ║       Arch Linux 包审计工具 v1.0                ║"
echo "  ║       分析中，请稍候...                          ║"
echo "  ╚══════════════════════════════════════════════════╝"
echo -e "${NC}"

# ── 基础统计 ──────────────────────────────────────────────────────────────
TOTAL=$(pacman -Q 2>/dev/null | wc -l)
EXPLICIT=$(pacman -Qe 2>/dev/null | wc -l)
DEPS=$(( TOTAL - EXPLICIT ))
ORPHANS=$(pacman -Qdt 2>/dev/null | wc -l)
AUR_PKGS=$(pacman -Qm 2>/dev/null | wc -l)

# ═══════════════════════════════════════════════════════════════════════════
# 1. 总览
# ═══════════════════════════════════════════════════════════════════════════
section "📊 总体概览"
echo -e "  总安装包数         ${BOLD}${TOTAL}${NC}"
echo -e "  ├─ 你手动安装的     ${BOLD}${EXPLICIT}${NC}"
echo -e "  └─ 自动依赖安装的   ${BOLD}${DEPS}${NC}"
echo -e "  孤儿包（待清理）    ${BOLD}${ORPHANS}${NC}"
echo -e "  外部包（AUR）       ${BOLD}${AUR_PKGS}${NC}"

# ═══════════════════════════════════════════════════════════════════════════
# 2. 手动安装包分类
# ═══════════════════════════════════════════════════════════════════════════
section "📦 你手动安装的 ${EXPLICIT} 个包分类"

EXPLICIT_LIST=$(pacman -Qqe 2>/dev/null)

declare -A CATS
CATS["🖥️  窗口管理器 / 显示"]="niri greetd greetd-tuigreet kitty xorg-xwayland xwayland-satellite xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal noctalia-shell"
CATS["⌨️  输入法（中文）"]="fcitx5 fcitx5-chinese-addons fcitx5-configtool fcitx5-gtk fcitx5-qt"
CATS["💻  开发工具"]="neovim nodejs nvm pnpm ripgrep starship fastfetch godot tiled vulkan-headers vulkan-tools yazi android-tools android-udev cuda"
CATS["🎨  多媒体 / 图形"]="blender gimp libreoffice-fresh libreoffice-fresh-zh-cn nomacs obsidian satty vlc vlc-plugins-all"
CATS["🎮  游戏"]="steam lutris protonplus glmark2 mesa-utils"
CATS["🌐  网络 / 通信"]="telegram-desktop clash-verge-rev-bin openssh syncthing dnsmasq easytier-bin scrcpy"
CATS["🔧  系统工具"]="bleachbit efibootmgr etckeeper reflector pacman-contrib btrfs-progs compsize timeshift zram-generator networkmanager bluez upower udisks2 udiskie flatpak grub os-prober intel-ucode linux-firmware linux-zen linux-zen-headers nvidia-open-dkms nvidia-prime cliphist libinput-tools mission-center stress"
CATS["📝  字体"]="noto-fonts-cjk noto-fonts-emoji ttf-jetbrains-mono-nerd"
CATS["📦  归档 / 压缩"]="7zip zip unzip"
CATS["🔗  其他"]="base base-devel fuse2 lib32-gnutls lib32-libpulse libappindicator qt5-graphicaleffects qt5-quickcontrols2 pipewire-pulse"

for cat_name in "${!CATS[@]}"; do
  pkgs=""
  count=0
  for pkg in ${CATS[$cat_name]}; do
    if echo "$EXPLICIT_LIST" | grep -qxF "$pkg" 2>/dev/null; then
      ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
      pkgs+="    $pkg  ${ver:-}\n"
      ((count++))
    fi
  done
  if [ "$count" -gt 0 ]; then
    echo -e "\n  ${BOLD}${cat_name}${NC} (${count})"
    echo -e "$pkgs"
  fi
done

# ═══════════════════════════════════════════════════════════════════════════
# 3. 孤儿包
# ═══════════════════════════════════════════════════════════════════════════
section "🧹 孤儿包（不再被任何包依赖，可安全删除）"
ORPHAN_LIST=$(pacman -Qdt 2>/dev/null)
if [ -z "$ORPHAN_LIST" ]; then
  ok "没有孤儿包，系统很干净！"
else
  ORPHAN_TOTAL_MIB=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    pkg=$(echo "$line" | awk '{print $1}')
    ver=$(echo "$line" | awk '{print $2}')
    size_str=$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | grep 'Installed Size' | awk '{print $4, $5}')
    size_num=$(echo "$size_str" | awk '{print $1}')
    size_unit=$(echo "$size_str" | awk '{print $2}')
    # 用 awk 做浮点累加，不依赖 bc
    if [ "$size_unit" = "MiB" ]; then
      ORPHAN_TOTAL_MIB=$(awk "BEGIN{printf \"%.1f\", ${ORPHAN_TOTAL_MIB:-0} + ${size_num:-0}}" 2>/dev/null)
    elif [ "$size_unit" = "KiB" ]; then
      ORPHAN_TOTAL_MIB=$(awk "BEGIN{printf \"%.1f\", ${ORPHAN_TOTAL_MIB:-0} + ${size_num:-0} / 1024}" 2>/dev/null)
    fi
    big " $pkg  $ver  —  $size_str"
  done <<< "$ORPHAN_LIST"
  echo
  warn "建议删除孤儿包（预计释放 ~${ORPHAN_TOTAL_MIB%.*} MiB）："
  echo '    sudo pacman -Rns $(pacman -Qdtq)'
fi

# ═══════════════════════════════════════════════════════════════════════════
# 4. 按大小排序 TOP 30
# ═══════════════════════════════════════════════════════════════════════════
section "📏 按大小排序（前 30 名）"

TMPFILE=$(mktemp)
LC_ALL=C pacman -Qi 2>/dev/null | grep -E '^(Name|Installed Size)' | paste - - |
  sed 's/Name *: //;s/Installed Size *: //' |
  awk '{
    size=$2; unit=$3; name=$1;
    if(unit=="MiB") printf "%8.2f MiB\t%s\n", size, name;
    else if(unit=="KiB") printf "%8.2f MiB\t%s\n", size/1024, name;
    else if(unit=="B") printf "%8.2f MiB\t%s\n", size/1048576, name;
  }' | sort -rn > "$TMPFILE"

# 用纯 bash + printf 输出颜色，避免 awk 的颜色转义问题
i=0
while IFS=$'\t' read -r s name; do
  ((i++))
  [ $i -gt 30 ] && break
  size_val=$(echo "$s" | awk '{print $1}')
  if awk "BEGIN{exit(${size_val} > 200 ? 0 : 1)}" 2>/dev/null; then
    printf "  %-3d  ${RED}%8.2f MiB${NC}  %s\n" "$i" "$size_val" "$name"
  elif awk "BEGIN{exit(${size_val} > 100 ? 0 : 1)}" 2>/dev/null; then
    printf "  %-3d  ${YELLOW}%8.2f MiB${NC}  %s\n" "$i" "$size_val" "$name"
  else
    printf "  %-3d  ${GREEN}%8.2f MiB${NC}  %s\n" "$i" "$size_val" "$name"
  fi
done < "$TMPFILE"
rm -f "$TMPFILE"

# ═══════════════════════════════════════════════════════════════════════════
# 5. AUR 外部包
# ═══════════════════════════════════════════════════════════════════════════
if [ "$AUR_PKGS" -gt 0 ]; then
  section "🏗️  外部包（AUR / 非官方源）"
  echo -e "  共 ${BOLD}${AUR_PKGS}${NC} 个\n"

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    pkg=$(echo "$line" | awk '{print $1}')
    ver=$(echo "$line" | awk '{print $2}')
    size_str=$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | grep 'Installed Size' | awk '{print $4, $5}')
    echo -e "  ${CYAN}${pkg}${NC}  ${ver}  —  ${size_str}"
  done <<< "$(pacman -Qm 2>/dev/null)"
fi

# ═══════════════════════════════════════════════════════════════════════════
# 6. 可考虑精简的大包
# ═══════════════════════════════════════════════════════════════════════════
section "💡 可考虑精简的大体积包"

BIG_CANDIDATES=(
  "libreoffice-fresh|办公套件，不用可删"
  "blender|3D 建模软件，不用可删"
  "rust|孤儿包，不写 Rust 可删"
  "clash-verge-rev-bin|代理客户端，不用可删"
  "godot|游戏引擎，不用可删"
  "cuda|GPU 计算工具包，不用可删"
  "gimp|图像编辑，不用可删"
)

found=false
for entry in "${BIG_CANDIDATES[@]}"; do
  pkg="${entry%%|*}"
  desc="${entry##*|}"
  if pacman -Q "$pkg" &>/dev/null 2>&1; then
    found=true
    size_str=$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | grep 'Installed Size' | awk '{print $4, $5}')
    echo -e "\n  ${YELLOW}${pkg}${NC}  (${size_str})"
    echo -e "    ${desc}"
  fi
done
if ! $found; then
  ok "没有明显可精简的大包"
fi

# ═══════════════════════════════════════════════════════════════════════════
# 7. 缓存分析
# ═══════════════════════════════════════════════════════════════════════════
section "🗑️  pacman 缓存分析"
if [ -d /var/cache/pacman/pkg ]; then
  cache_size=$(du -sh /var/cache/pacman/pkg/ 2>/dev/null | awk '{print $1}')
  echo -e "  缓存目录大小：${BOLD}${cache_size}${NC}"

  if command -v paccache &>/dev/null; then
    cleanable=$(safe_run paccache -dk1 | grep -oP 'disk space saved: \K[^)]+' || echo "无法计算")
    echo -e "  其中旧版本可清理：${cleanable}"
    echo
    echo "  清理命令："
    echo '    sudo paccache -rk2         # 保留最近 2 个版本'
    echo '    sudo paccache -ruk0        # 清理未安装包的缓存'
  else
    warn "未安装 pacman-contrib，缺少 paccache 工具"
    echo "  安装：sudo pacman -S pacman-contrib"
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# 8. 内核信息
# ═══════════════════════════════════════════════════════════════════════════
section "🧑‍💻 内核信息"
current_kernel=$(uname -r)
echo -e "  当前运行：${BOLD}${current_kernel}${NC}"
installed_kernels=$(pacman -Q 2>/dev/null | grep -E '^linux[0-9]?[0-9]? ' | awk '{print $1, $2}' | grep -v firmware)
if [ -n "$installed_kernels" ]; then
  echo "$installed_kernels" | while IFS= read -r line; do
    echo "  ${line}"
  done
fi

# ═══════════════════════════════════════════════════════════════════════════
# 9. 汇总命令
# ═══════════════════════════════════════════════════════════════════════════
section "📋 快速清理命令汇总"
echo "  # 删除孤儿包"
echo '  sudo pacman -Rns $(pacman -Qdtq)'
echo
echo "  # 清理 pacman 缓存"
echo '  sudo paccache -rk2'
echo
echo "  # 大包精简（按需取消注释执行）"
echo '  # sudo pacman -Rns libreoffice-fresh  # ~421 MiB'
echo '  # sudo pacman -Rns blender             # ~378 MiB'
echo '  # sudo pacman -Rns clash-verge-rev-bin # ~236 MiB'
echo '  # sudo pacman -Rns godot               # ~172 MiB'
echo '  # sudo pacman -Rns gimp                # ~152 MiB'
echo

echo -e "${BOLD}${MAGENTA}  ═══════════════════════════════════════════════${NC}"
echo -e "${BOLD}${MAGENTA}  审计完成！${NC}"

# ═══════════════════════════════════════════════════════════════════════════
# 可选：JSON 输出
# ═══════════════════════════════════════════════════════════════════════════
if [ "${1:-}" = "--json" ]; then
  report_file="/tmp/arch-pkg-audit-$(date +%Y%m%d-%H%M%S).json"
  cat > "$report_file" <<JSONEOF
{
  "total_packages": $TOTAL,
  "explicit": $EXPLICIT,
  "dependencies": $DEPS,
  "orphans": $ORPHANS,
  "aur_packages": $AUR_PKGS,
  "generated_at": "$(date --iso-8601=seconds)"
}
JSONEOF
  echo -e "\nJSON 报告已保存到：${CYAN}${report_file}${NC}"
fi

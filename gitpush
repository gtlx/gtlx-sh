# =====================================================
#  Git Auto Commit & Push Tool v2.3
# =====================================================
#  Usage:
#    bash gitpush.sh [folder]                # commit & push
#    bash gitpush.sh --set-folder <path>     # set default folder
#    bash gitpush.sh --set-remote <url>      # set default remote repo
#    bash gitpush.sh --set-user <name>       # set default user.name
#    bash gitpush.sh --set-email <email>     # set default user.email
#    bash gitpush.sh --set-conf <path>       # permanently change config file path
#    bash gitpush.sh --conf <path>           # use alternate config for this run
#    bash gitpush.sh --init                  # generate/overwrite default config file
#    bash gitpush.sh --show                  # view current defaults
#    bash gitpush.sh --help                  # show this help
# =====================================================

set -e

# ---------- detect script dir & config file path (can be overridden) ----------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd 2>/dev/null || echo ".")"
# 如果脚本同目录有 gitpush.conf，默认使用它（不用每次 --conf）
CONF_FILE="$HOME/.gitpush.conf"
if [ -f "$SCRIPT_DIR/gitpush.conf" ]; then
    CONF_FILE="$SCRIPT_DIR/gitpush.conf"
fi

# ---------- preprocess: extract --conf / --set-conf early ----------
NEW_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --conf|--set-conf)
            if [ -n "$2" ]; then
                CONF_FILE="$2"
                if [ "$1" = "--set-conf" ]; then
                    SET_CONF_PERMANENT=1
                fi
                shift 2
            else
                echo "❌ 错误：\`$1\` 需要接一个文件路径"
                exit 1
            fi
            ;;
        *)
            NEW_ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${NEW_ARGS[@]}"

# ---------- load config file if it exists ----------
BATCH_MARKER="### ---BATCH_TASKS---"
if [ -f "$CONF_FILE" ]; then
    if grep -q "^$BATCH_MARKER" "$CONF_FILE" 2>/dev/null; then
        # 有批量标记：只 source 标记之前的部分（变量定义区）
        mkdir -p "$SCRIPT_DIR/tmp"
        sed -n "1,/^$BATCH_MARKER/p" "$CONF_FILE" | grep -v "^$BATCH_MARKER" > "$SCRIPT_DIR/tmp/gitpush_sourced.conf"
        source "$SCRIPT_DIR/tmp/gitpush_sourced.conf"
        rm -f "$SCRIPT_DIR/tmp/gitpush_sourced.conf"
        echo "ℹ️  检测到批量任务标记，已加载变量定义部分"
    else
        # 无标记：整个文件 source（向后兼容旧配置）
        source "$CONF_FILE"
    fi
fi

# ---------- defaults (fallback to empty) ----------
DEFAULT_FOLDER="${DEFAULT_FOLDER:-}"
DEFAULT_REMOTE="${DEFAULT_REMOTE:-}"
DEFAULT_USER="${DEFAULT_USER:-}"
DEFAULT_EMAIL="${DEFAULT_EMAIL:-}"

# ---------- functions ----------
save_config() {
    mkdir -p "$(dirname "$CONF_FILE")"
    cat > "$CONF_FILE" <<EOF
# =========================================
#  GitPush 默认配置文件
#  生成时间: $(date '+%Y-%m-%d %H:%M:%S')
# =========================================
#  默认文件夹路径 —— 执行 gitpush.sh 不传文件夹时使用
DEFAULT_FOLDER="$DEFAULT_FOLDER"
#  默认远程仓库地址 —— 例如 git@github.com:user/repo.git
DEFAULT_REMOTE="$DEFAULT_REMOTE"
#  默认 Git 用户名 —— 对应 git config user.name
DEFAULT_USER="$DEFAULT_USER"
#  默认 Git 邮箱 —— 对应 git config user.email
DEFAULT_EMAIL="$DEFAULT_EMAIL"
# =========================================
#  批量任务（可选）：在下方添加 ### ---BATCH_TASKS--- 标记，
#  然后在标记后逐行写批量任务，格式：文件夹|远程URL|分支|提交信息
#  例如：
#  ### ---BATCH_TASKS---
#  项目A文件夹|||
#  项目B文件夹|git@gitee.com:me/backup.git||
# =========================================
EOF
    echo "✅ 配置已保存到 $CONF_FILE"
}

show_config() {
    echo "⚙️  当前默认配置："
    echo "   配置文件 : $CONF_FILE"
    echo "   文件夹   : ${DEFAULT_FOLDER:-(未设置)}"
    echo "   远程仓库 : ${DEFAULT_REMOTE:-(未设置)}"
    echo "   用户名   : ${DEFAULT_USER:-(未设置)}"
    echo "   邮箱     : ${DEFAULT_EMAIL:-(未设置)}"
    echo ""
}

read_batch_config() {
    # 读取批量配置文件，每行一个任务
    # 格式：文件夹|远程URL|分支|提交信息
    # 支持 ### ---BATCH_TASKS--- 标记：只解析标记之后的行（标记前是变量区，已被 source 加载）
    # 如果没有标记，整个文件当纯批量任务解析（向后兼容独立批量文件）
    # 空行和 # 开头的行忽略
    local file="$1"
    BATCH_TASKS=()
    if [ ! -f "$file" ]; then
        echo "❌ 错误：批量配置文件「$file」不存在"
        exit 1
    fi
    
    local IN_BATCH=0
    local HAS_MARKER=0
    if grep -q "^$BATCH_MARKER" "$file" 2>/dev/null; then
        HAS_MARKER=1
    fi
    
    while IFS= read -r line || [ -n "$line" ]; do
        # 检测标记行
        if echo "$line" | grep -q "^$BATCH_MARKER"; then
            IN_BATCH=1
            continue
        fi
        # 如果没有标记，从头到尾都解析（兼容旧独立批量文件）
        [ "$HAS_MARKER" = "0" ] && IN_BATCH=1
        # 还没到批量区，跳过
        [ "$IN_BATCH" = "0" ] && continue
        # 解析任务行
        line=$(echo "$line" | sed 's/#.*//' | xargs)
        [ -z "$line" ] && continue
        BATCH_TASKS+=("$line")
    done < "$file"
    
    if [ ${#BATCH_TASKS[@]} -eq 0 ]; then
        echo "❌ 错误：批量配置文件中没有有效任务"
        exit 1
    fi
}

print_help() {
    echo "用法："
    echo "  bash $0 [文件夹] [提交信息]                 # 使用默认配置提交指定文件夹"
    echo "  bash $0 --pull                               # 拉取远程仓库最新内容"
    echo "  bash $0 --pull <文件夹>                      # 拉取指定文件夹所在仓库"
    echo "  bash $0 --pull <文件夹> <分支>               # 拉取指定仓库的指定分支"
    echo "  bash $0 --pull <分支>                        # 拉取当前仓库的指定分支"
    echo "  bash $0 --batch [配置文件]                   # 批量处理（默认用脚本旁 gitpush.conf）"
    echo "  bash $0 --set-folder <路径>                 # 设置默认文件夹"
    echo "  bash $0 --set-remote <地址>                 # 设置默认远程仓库地址"
    echo "  bash $0 --set-user <名字>                   # 设置默认 Git 用户名"
    echo "  bash $0 --set-email <邮箱>                  # 设置默认 Git 邮箱"
    echo "  bash $0 --set-conf <路径>                   # 永久更改配置文件路径"
    echo "  bash $0 --conf <路径>                       # 本次临时使用指定配置文件"
    echo "  bash $0 --init                              # 生成/覆盖默认配置文件"
    echo "  bash $0 --show                              # 查看当前默认配置"
    echo "  bash $0 --help                              # 显示此帮助信息"
    echo ""
    echo "高级选项（伴随提交使用）："
    echo "  --remote <地址>   本次临时覆盖远程仓库地址"
    echo "  --user  <名字>    本次临时覆盖用户名"
    echo "  --email <邮箱>    本次临时覆盖邮箱"
}

# ---------- batch processing function ----------
# 参数：$1=文件夹 $2=提交信息 $3=远程URL $4=用户名 $5=邮箱 $6=pull模式(1/0) $7=pull分支名
process_repo() {
    local TARGET_FOLDER="$1"
    local COMMIT_MSG="$2"
    local REMOTE_URL="$3"
    local USER_NAME="$4"
    local USER_EMAIL="$5"
    local IS_PULL="$6"
    local PULL_BRANCH="$7"

    echo ""
    echo "═══════════════════════════════════════"
    echo "📁 目标文件夹 : $TARGET_FOLDER"
    [ -n "$COMMIT_MSG" ] && echo "💬 提交信息   : $COMMIT_MSG"
    echo "═══════════════════════════════════════"

    if [ ! -d "$TARGET_FOLDER" ]; then
        echo "❌ 错误：文件夹「$TARGET_FOLDER」不存在，跳过"
        return 1
    fi

    cd "$TARGET_FOLDER"
    git config --global --add safe.directory "$(pwd)" 2>/dev/null || true

    local REPO_ROOT=""
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
        REPO_ROOT=$(git rev-parse --show-toplevel)
        cd "$REPO_ROOT"
        echo "📦 检测到 Git 仓库根目录：$REPO_ROOT"
    else
        echo "⚠️  非 Git 仓库，正在自动初始化..."
        git init
        REPO_ROOT="$TARGET_FOLDER"
        echo "✅ git init 完成"
        if [ -n "$REMOTE_URL" ]; then
            git remote add origin "$REMOTE_URL" 2>/dev/null || echo "ℹ️  远程仓库 origin 可能已存在，跳过添加"
            echo "🌐 已关联远程仓库：$REMOTE_URL"
        else
            echo "⚠️  未提供远程仓库地址，跳过远程设置"
        fi
        [ -n "$USER_NAME" ]  && git config user.name "$USER_NAME"
        [ -n "$USER_EMAIL" ] && git config user.email "$USER_EMAIL"
    fi

    if [ -n "$REMOTE_URL" ]; then
        if ! git remote get-url origin >/dev/null 2>&1; then
            git remote add origin "$REMOTE_URL"
            echo "🌐 已添加远程仓库：$REMOTE_URL"
        fi
    fi

    if [ -n "$USER_NAME" ] && [ -z "$(git config user.name)" ]; then
        git config user.name "$USER_NAME"
        echo "👤 已设置 user.name：$USER_NAME"
    fi
    if [ -n "$USER_EMAIL" ] && [ -z "$(git config user.email)" ]; then
        git config user.email "$USER_EMAIL"
        echo "📧 已设置 user.email：$USER_EMAIL"
    fi

    # ---------- PULL MODE ----------
    if [ "$IS_PULL" = "1" ]; then
        if ! git remote get-url origin >/dev/null 2>&1; then
            echo "❌ 错误：未配置远程仓库，无法拉取"
            return 1
        fi
        local BRANCH=$(git branch --show-current)
        PULL_BRANCH="${PULL_BRANCH:-$BRANCH}"
        echo "⬇️  正在获取远程最新信息..."
        git fetch origin "$PULL_BRANCH" 2>/dev/null || true

        local LOCAL_HASH=$(git rev-parse HEAD 2>/dev/null)
        local REMOTE_HASH=$(git rev-parse "origin/$PULL_BRANCH" 2>/dev/null)

        if [ -z "$REMOTE_HASH" ]; then
            echo "❌ 错误：远程分支 origin/$PULL_BRANCH 不存在"
            return 1
        fi
        if [ "$LOCAL_HASH" = "$REMOTE_HASH" ]; then
            echo "✅ 已是最新，无需拉取"
            return 0
        fi
        if git merge-base --is-ancestor "$LOCAL_HASH" "$REMOTE_HASH" 2>/dev/null; then
            echo "📥 快进合并，直接拉取..."
            git pull origin "$PULL_BRANCH" --ff-only
            echo "✅ 拉取成功！"
            return 0
        fi

        echo ""
        echo "⚠️  ═══════════════════════════════════"
        echo "   本地和远程分支分叉了！请选择处理方式："
        echo "   [1] merge  —— 合并远程，保留双方历史"
        echo "   [2] rebase —— 把你的提交变基到远程（线性历史）"
        echo "   [3] 放弃   —— 不做拉取，手动处理"
        echo "═══════════════════════════════════════"
        read -p "👉 请输入选项 (1/2/3): " CHOICE
        case "$CHOICE" in
            1) git pull origin "$PULL_BRANCH" --no-rebase; echo "✅ 合并拉取成功！" ;;
            2) git pull origin "$PULL_BRANCH" --rebase; echo "✅ 变基拉取成功！" ;;
            3) echo "🚫 已取消拉取"; return 1 ;;
            *) echo "❌ 无效选项，已取消"; return 1 ;;
        esac
        return 0
    fi

    # ---------- PUSH MODE ----------
    local REL_PATH=$(realpath --relative-to="$REPO_ROOT" "$TARGET_FOLDER" 2>/dev/null || echo ".")
    if [ "$REL_PATH" = "" ] || [[ "$REL_PATH" == ../* ]]; then
        REL_PATH="."
    fi
    echo "📌 仓库内相对路径：$REL_PATH"

    if [ -z "$(git status --porcelain -- "$REL_PATH")" ]; then
        echo "✅ 该路径下暂无变更，无需提交。"
        return 0
    fi

    git add "$REL_PATH"
    git commit -m "$COMMIT_MSG"

    local BRANCH=$(git branch --show-current)
    if [ -z "$BRANCH" ]; then
        BRANCH="main"
        git branch -M main
    fi

    if git remote get-url origin >/dev/null 2>&1; then
        echo "🚀 正在推送到 origin/$BRANCH ..."
        local PUSH_OUTPUT=$(git push -u origin "$BRANCH" 2>&1)
        local PUSH_EXIT=$?

        if [ $PUSH_EXIT -eq 0 ]; then
            echo "✅ 推送成功！"
            return 0
        fi

        if echo "$PUSH_OUTPUT" | grep -q "rejected\|fetch first"; then
            echo ""
            echo "⚠️  ═══════════════════════════════════"
            echo "   推送被拒！远程有你没拉取的更新。"
            echo "   要先拉取合并再推送吗？"
            echo "   [1] 是   [2] 否"
            echo "═══════════════════════════════════════"
            read -p "👉 请输入选项 (1/2): " PUSH_CHOICE

            if [ "$PUSH_CHOICE" = "1" ]; then
                echo "⬇️  正在获取远程更新..."
                git fetch origin "$BRANCH"
                local LH=$(git rev-parse HEAD 2>/dev/null)
                local RH=$(git rev-parse "origin/$BRANCH" 2>/dev/null)
                if [ -n "$RH" ] && git merge-base --is-ancestor "$LH" "$RH" 2>/dev/null; then
                    echo "📥 快进合并，直接拉取..."
                    git pull origin "$BRANCH" --ff-only
                else
                    echo ""
                    echo "⚠️  分支分叉！请选择合并策略："
                    echo "   [1] merge  [2] rebase  [3] 放弃"
                    read -p "👉 请输入选项 (1/2/3): " SUB_CHOICE
                    case "$SUB_CHOICE" in
                        1) git pull origin "$BRANCH" --no-rebase ;;
                        2) git pull origin "$BRANCH" --rebase ;;
                        3) echo "🚫 已取消"; return 1 ;;
                        *) echo "❌ 无效，退出"; return 1 ;;
                    esac
                fi
                echo "🚀 重新推送..."
                git push -u origin "$BRANCH"
                echo "✅ 推送成功！"
                return 0
            else
                echo "🚫 推送已取消，请手动处理"
                return 1
            fi
        else
            echo "❌ 推送失败："
            echo "$PUSH_OUTPUT"
            return 1
        fi
    else
        echo "⚠️  未配置远程仓库，跳过推送"
        return 0
    fi
}

# ---------- handle --set-conf (immediate exit after saving) ----------
if [ "$SET_CONF_PERMANENT" = "1" ]; then
    save_config
    echo "📂 默认配置文件路径已永久设置为：$CONF_FILE"
    exit 0
fi

# ---------- parse remaining arguments ----------
TARGET_FOLDER=""
COMMIT_MSG=""
TMP_REMOTE=""
TMP_USER=""
TMP_EMAIL=""
PULL_MODE=0
PULL_BRANCH=""
BATCH_MODE=0
BATCH_CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --set-folder)
            DEFAULT_FOLDER="$2"
            save_config
            echo "📁 默认文件夹已更新为：$DEFAULT_FOLDER"
            exit 0
            ;;
        --set-remote)
            DEFAULT_REMOTE="$2"
            save_config
            echo "🌐 默认远程仓库地址已更新为：$DEFAULT_REMOTE"
            exit 0
            ;;
        --set-user)
            DEFAULT_USER="$2"
            save_config
            echo "👤 默认 Git 用户名已更新为：$DEFAULT_USER"
            exit 0
            ;;
        --set-email)
            DEFAULT_EMAIL="$2"
            save_config
            echo "📧 默认邮箱已更新为：$DEFAULT_EMAIL"
            exit 0
            ;;
        --show)
            show_config
            exit 0
            ;;
        --help)
            print_help
            exit 0
            ;;
        --init)
            CONF_FILE="$SCRIPT_DIR/gitpush.conf"
            save_config
            exit 0
            ;;
        --remote)
            TMP_REMOTE="$2"
            shift 2
            ;;
        --user)
            TMP_USER="$2"
            shift 2
            ;;
        --email)
            TMP_EMAIL="$2"
            shift 2
            ;;
        --batch)
            BATCH_MODE=1
            shift
            if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
                BATCH_CONFIG_FILE="$1"
                shift
            else
                BATCH_CONFIG_FILE="$CONF_FILE"
            fi
            ;;
        --pull)
            PULL_MODE=1
            shift
            # 可选：后面接文件夹 / 分支名
            if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
                if [ -d "$1" ]; then
                    TARGET_FOLDER="$1"
                    shift
                    if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
                        PULL_BRANCH="$1"
                        shift
                    fi
                else
                    PULL_BRANCH="$1"
                    shift
                fi
            fi
            ;;
        *)
            if [ -z "$TARGET_FOLDER" ]; then
                # 智能判断：目录 → 文件夹；否则若已设默认 → 作为提交信息
                if [ -d "$1" ]; then
                    TARGET_FOLDER="$1"
                elif [ -n "$DEFAULT_FOLDER" ]; then
                    COMMIT_MSG="$1"
                else
                    TARGET_FOLDER="$1"
                fi
            elif [ -z "$COMMIT_MSG" ]; then
                COMMIT_MSG="$1"
            fi
            shift
            ;;
    esac
done

# ---------- BATCH MODE ----------
if [ "$BATCH_MODE" = "1" ]; then
    read_batch_config "$BATCH_CONFIG_FILE"
    echo "📦 批量模式启动，共 ${#BATCH_TASKS[@]} 个任务"
    for TASK in "${BATCH_TASKS[@]}"; do
        IFS='|' read -r BFOLDER BREMOTE BBRANCH BMSG <<< "$TASK"
        BFOLDER=$(echo "$BFOLDER" | xargs)
        BREMOTE=$(echo "$BREMOTE" | xargs)
        BBRANCH=$(echo "$BBRANCH" | xargs)
        BMSG=$(echo "$BMSG" | xargs)
        
        # 回退逻辑：空字段用默认值或自动生成
        BRANCH_TO_USE="${BBRANCH:-$(git -C "$BFOLDER" branch --show-current 2>/dev/null || echo "main")}"
        MSG_TO_USE="${BMSG:-更新 $(date '+%Y-%m-%d %H:%M:%S')}"
        
        process_repo \
            "$BFOLDER" \
            "$MSG_TO_USE" \
            "${BREMOTE:-$DEFAULT_REMOTE}" \
            "${TMP_USER:-$DEFAULT_USER}" \
            "${TMP_EMAIL:-$DEFAULT_EMAIL}" \
            "0" \
            "$BRANCH_TO_USE" || echo "⚠️  任务失败，继续下一个..."
        echo ""
    done
    echo "✅ 批量处理完成！"
    exit 0
fi

# ---------- fall back to defaults if not provided ----------
if [ -z "$TARGET_FOLDER" ]; then
    TARGET_FOLDER="$DEFAULT_FOLDER"
fi

if [ -z "$TARGET_FOLDER" ]; then
    echo "❌ 错误：没有指定文件夹，且未设置默认文件夹。"
    echo "用法：bash $0 <文件夹>  或  bash $0 --set-folder <路径>"
    exit 1
fi

if [ ! -d "$TARGET_FOLDER" ]; then
    echo "❌ 错误：文件夹「$TARGET_FOLDER」不存在"
    exit 1
fi

# ---------- set commit message (default to timestamp) ----------
COMMIT_MSG="${COMMIT_MSG:-更新 $(date '+%Y-%m-%d %H:%M:%S')}"

# ---------- resolve final values (tmp > default) ----------
REMOTE_URL="${TMP_REMOTE:-$DEFAULT_REMOTE}"
USER_NAME="${TMP_USER:-$DEFAULT_USER}"
USER_EMAIL="${TMP_EMAIL:-$DEFAULT_EMAIL}"

echo "📁 目标文件夹 : $TARGET_FOLDER"
echo "💬 提交信息   : $COMMIT_MSG"

# ---------- enter folder & check if it is a git repo ----------
cd "$TARGET_FOLDER"

# 解除可能出现的 "dubious ownership" 限制（sdcard 挂载场景常见）
git config --global --add safe.directory "$(pwd)" 2>/dev/null || true

REPO_ROOT=""
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    REPO_ROOT=$(git rev-parse --show-toplevel)
    cd "$REPO_ROOT"
    echo "📦 检测到 Git 仓库根目录：$REPO_ROOT"
else
    echo "⚠️  非 Git 仓库，正在自动初始化..."
    git init
    REPO_ROOT="$TARGET_FOLDER"
    echo "✅ git init 完成"

    if [ -n "$REMOTE_URL" ]; then
        git remote add origin "$REMOTE_URL" 2>/dev/null || echo "ℹ️  远程仓库 origin 可能已存在，跳过添加"
        echo "🌐 已关联远程仓库：$REMOTE_URL"
    else
        echo "⚠️  未提供远程仓库地址，跳过远程设置"
    fi

    [ -n "$USER_NAME" ]  && git config user.name "$USER_NAME"
    [ -n "$USER_EMAIL" ] && git config user.email "$USER_EMAIL"
fi

# ---------- if remote not set but we have one, add it ----------
if [ -n "$REMOTE_URL" ]; then
    if ! git remote get-url origin >/dev/null 2>&1; then
        git remote add origin "$REMOTE_URL"
        echo "🌐 已添加远程仓库：$REMOTE_URL"
    fi
fi

# ---------- fill in user.name / user.email if missing ----------
if [ -n "$USER_NAME" ] && [ -z "$(git config user.name)" ]; then
    git config user.name "$USER_NAME"
    echo "👤 已设置 user.name：$USER_NAME"
fi
if [ -n "$USER_EMAIL" ] && [ -z "$(git config user.email)" ]; then
    git config user.email "$USER_EMAIL"
    echo "📧 已设置 user.email：$USER_EMAIL"
fi

# ---------- PULL MODE ----------
if [ "$PULL_MODE" = "1" ]; then
    if ! git remote get-url origin >/dev/null 2>&1; then
        echo "❌ 错误：未配置远程仓库，无法拉取"
        exit 1
    fi
    BRANCH=$(git branch --show-current)
    PULL_BRANCH="${PULL_BRANCH:-$BRANCH}"
    echo "⬇️  正在获取远程最新信息..."
    git fetch origin "$PULL_BRANCH" 2>/dev/null || true

    LOCAL_HASH=$(git rev-parse HEAD 2>/dev/null)
    REMOTE_HASH=$(git rev-parse "origin/$PULL_BRANCH" 2>/dev/null)

    if [ -z "$REMOTE_HASH" ]; then
        echo "❌ 错误：远程分支 origin/$PULL_BRANCH 不存在"
        exit 1
    fi

    if [ "$LOCAL_HASH" = "$REMOTE_HASH" ]; then
        echo "✅ 已是最新，无需拉取"
        exit 0
    fi

    # 快进？直接拉
    if git merge-base --is-ancestor "$LOCAL_HASH" "$REMOTE_HASH" 2>/dev/null; then
        echo "📥 快进合并，直接拉取..."
        git pull origin "$PULL_BRANCH" --ff-only
        echo "✅ 拉取成功！"
        exit 0
    fi

    # 分叉了——弹出选择菜单
    echo ""
    echo "⚠️  ═══════════════════════════════════"
    echo "   本地和远程分支分叉了！请选择处理方式："
    echo "   [1] merge  —— 合并远程，保留双方历史（会产生合并提交）"
    echo "   [2] rebase —— 把你的提交变基到远程最新（线性历史）"
    echo "   [3] 放弃   —— 不做拉取，手动处理"
    echo "═══════════════════════════════════════"
    read -p "👉 请输入选项 (1/2/3): " CHOICE

    case "$CHOICE" in
        1)
            echo "🔄 正在用 merge 策略拉取..."
            git pull origin "$PULL_BRANCH" --no-rebase
            echo "✅ 合并拉取成功！"
            ;;
        2)
            echo "🔄 正在用 rebase 策略拉取..."
            git pull origin "$PULL_BRANCH" --rebase
            echo "✅ 变基拉取成功！"
            ;;
        3)
            echo "🚫 已取消拉取，请手动处理冲突"
            exit 0
            ;;
        *)
            echo "❌ 无效选项，已取消"
            exit 1
            ;;
    esac
    exit 0
fi

# ---------- compute relative path within the repo ----------
REL_PATH=$(realpath --relative-to="$REPO_ROOT" "$TARGET_FOLDER" 2>/dev/null || echo ".")
# 如果相对路径以 ../ 开头或为空，说明 realpath 被符号链接/挂载搞晕了，直接用根目录 "."
if [ "$REL_PATH" = "" ] || [[ "$REL_PATH" == ../* ]]; then
    REL_PATH="."
fi
echo "📌 仓库内相对路径：$REL_PATH"

# ---------- check if there are any changes ----------
if [ -z "$(git status --porcelain -- "$REL_PATH")" ]; then
    echo "✅ 该路径下暂无变更，无需提交。"
    exit 0
fi

# ---------- git add / commit / push ----------
git add "$REL_PATH"
git commit -m "$COMMIT_MSG"

BRANCH=$(git branch --show-current)
if [ -z "$BRANCH" ]; then
    BRANCH="main"
    git branch -M main
fi

if git remote get-url origin >/dev/null 2>&1; then
    echo "🚀 正在推送到 origin/$BRANCH ..."

    PUSH_OUTPUT=$(git push -u origin "$BRANCH" 2>&1)
    PUSH_EXIT=$?

    if [ $PUSH_EXIT -eq 0 ]; then
        echo "✅ 推送成功！"
    else
        # 检查是否被拒绝（rejected）
        if echo "$PUSH_OUTPUT" | grep -q "rejected\|fetch first"; then
            echo ""
            echo "⚠️  ═══════════════════════════════════"
            echo "   推送被拒！远程有你没拉取的更新。"
            echo "   要先拉取合并再推送吗？"
            echo "   [1] 是   [2] 否"
            echo "═══════════════════════════════════════"
            read -p "👉 请输入选项 (1/2): " PUSH_CHOICE

            if [ "$PUSH_CHOICE" = "1" ]; then
                echo "⬇️  正在获取远程更新..."
                git fetch origin "$BRANCH"

                LOCAL_HASH=$(git rev-parse HEAD 2>/dev/null)
                REMOTE_HASH=$(git rev-parse "origin/$BRANCH" 2>/dev/null)

                # 快进？直接拉
                if [ -n "$REMOTE_HASH" ] && git merge-base --is-ancestor "$LOCAL_HASH" "$REMOTE_HASH" 2>/dev/null; then
                    echo "📥 快进合并，直接拉取..."
                    git pull origin "$BRANCH" --ff-only
                else
                    # 分叉，再问一次策略
                    echo ""
                    echo "⚠️  分支分叉！请选择合并策略："
                    echo "   [1] merge  [2] rebase  [3] 放弃"
                    read -p "👉 请输入选项 (1/2/3): " SUB_CHOICE
                    case "$SUB_CHOICE" in
                        1) git pull origin "$BRANCH" --no-rebase ;;
                        2) git pull origin "$BRANCH" --rebase ;;
                        3) echo "🚫 已取消"; exit 0 ;;
                        *) echo "❌ 无效，退出"; exit 1 ;;
                    esac
                fi

                echo "🚀 重新推送..."
                git push -u origin "$BRANCH"
                echo "✅ 推送成功！"
            else
                echo "🚫 推送已取消，请手动处理"
                exit 0
            fi
        else
            echo "❌ 推送失败："
            echo "$PUSH_OUTPUT"
            exit 1
        fi
    fi
else
    echo "⚠️  未配置远程仓库，跳过推送"
fi